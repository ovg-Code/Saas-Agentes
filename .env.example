# --- Plano de control (apps/api) ---
DATABASE_URL=postgres://agentes_app:agentes_app@localhost:5432/agentes
DATABASE_ADMIN_URL=postgres://agentes:agentes@localhost:5432/agentes
API_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# direct = llama al runtime por HTTP (desarrollo) | temporal = workflows durables (producción)
RUNTIME_MODE=direct
RUNTIME_URL=http://localhost:8090
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=agentes-runtime
# Clave para cifrar credenciales de conectores (32 bytes en base64). Genérala con: openssl rand -base64 32
VAULT_MASTER_KEY=
PLATFORM_ADMIN_TOKEN=cambia-esto

# --- Runtime (services/runtime) ---
# Gateway LLM (LiteLLM expone /v1/messages para cualquier proveedor)
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=sk-litellm-master
LLM_DEFAULT_MODEL=agente-default
# Modelo "fake" determinista para desarrollo/tests sin coste: LLM_PROVIDER=fake
LLM_PROVIDER=gateway
EMBEDDINGS_MODEL=embeddings-default

# --- Gateway (infra/litellm.yaml) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LITELLM_MASTER_KEY=sk-litellm-master

# --- Canales ---
# Graph API de WhatsApp Cloud (en local: node examples/whatsapp-mock/server.mjs -> http://localhost:9092)
WHATSAPP_API_BASE=https://graph.facebook.com/v23.0

# --- Conexiones OAuth (apps de plataforma; ver config/oauth-providers.yaml) ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_HUBSPOT_CLIENT_ID=
OAUTH_HUBSPOT_CLIENT_SECRET=
# Proveedor simulado para desarrollo (node examples/oauth-mock/server.mjs)
OAUTH_MOCK_URL=http://localhost:9093
OAUTH_MOCK_CLIENT_ID=agentes-dev
OAUTH_MOCK_CLIENT_SECRET=agentes-dev-secret
