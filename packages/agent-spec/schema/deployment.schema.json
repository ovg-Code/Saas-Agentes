{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentes.dev/schema/deployment.schema.json",
  "title": "Despliegue de un agente para un cliente",
  "description": "Capa 3: lo único que se escribe por cliente. Sin código y sin secretos (solo referencias).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant",
    "agent",
    "template"
  ],
  "properties": {
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "template": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}@[\\^~]?\\d+(\\.\\d+){0,2}$",
      "description": "id@rango semver, p.ej. atencion-cliente@^1.0"
    },
    "params": {
      "type": "object"
    },
    "connectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connector"
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      }
    },
    "credentials": {
      "type": "object",
      "description": "Nombre -> de dónde sale el secreto. Nunca el secreto en claro.",
      "additionalProperties": {
        "$ref": "#/$defs/credentialSource"
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Ruta local (CLI), URL http(s) o texto con prefijo text:"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "enum": [
          "widget",
          "api",
          "mcp",
          "whatsapp",
          "email",
          "voice"
        ]
      }
    },
    "autonomy": {
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "approval": {
                "enum": [
                  "policy",
                  "always",
                  "never"
                ]
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alias": {
              "type": "string"
            },
            "max_tokens": {
              "type": "integer"
            }
          }
        },
        "guardrails": {
          "type": "object"
        }
      }
    },
    "webhooks": {
      "type": "array",
      "description": "Webhooks salientes: el sistema del cliente reacciona a lo que hace el agente.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "enum": [
                "message.created",
                "tool.executed",
                "approval.requested",
                "handoff.requested"
              ]
            }
          },
          "secret": {
            "type": "string",
            "description": "Nombre de la credencial usada para firmar (HMAC)."
          }
        }
      }
    },
    "channel_settings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Configuración de canales que la necesitan (p.ej. WhatsApp). Solo referencias a credenciales.",
      "properties": {
        "whatsapp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phone_number_id",
            "credentials"
          ],
          "properties": {
            "phone_number_id": {
              "type": "string",
              "description": "ID del número en WhatsApp Business (Meta)"
            },
            "credentials": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "access_token",
                "app_secret",
                "verify_token"
              ],
              "properties": {
                "access_token": {
                  "type": "string",
                  "description": "Nombre en `credentials` del token de acceso (Graph API)"
                },
                "app_secret": {
                  "type": "string",
                  "description": "Nombre en `credentials` del app secret (firma de webhooks)"
                },
                "verify_token": {
                  "type": "string",
                  "description": "Nombre en `credentials` del verify token del webhook"
                }
              }
            },
            "reengagement_template": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "language"
              ],
              "description": "Plantilla aprobada por Meta para escribir fuera de la ventana de 24 h",
              "properties": {
                "name": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "type": {
          "enum": [
            "openapi",
            "mcp"
          ]
        },
        "spec": {
          "type": "string",
          "description": "openapi: ruta o URL del documento OpenAPI 3.x"
        },
        "url": {
          "type": "string",
          "description": "mcp: URL del servidor MCP remoto"
        },
        "base_url": {
          "type": "string",
          "description": "openapi: sobreescribe servers[0].url"
        },
        "auth": {
          "$ref": "#/$defs/auth"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "none",
            "api_key",
            "bearer",
            "basic",
            "oauth2"
          ]
        },
        "header": {
          "type": "string",
          "description": "api_key: cabecera donde va la clave (por defecto X-API-Key)"
        },
        "credential": {
          "type": "string",
          "description": "Nombre en `credentials`."
        },
        "provider": {
          "type": "string",
          "description": "oauth2: id del proveedor en el catálogo de la plataforma (config/oauth-providers.yaml)"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "oauth2: permisos a pedir (por defecto, los del proveedor)"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector"
      ],
      "properties": {
        "connector": {
          "type": "string",
          "description": "id del conector, o 'builtin'"
        },
        "operation": {
          "type": "string",
          "description": "openapi: operationId o 'METHOD /ruta'. mcp: nombre de la tool."
        }
      }
    },
    "credentialSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_env": {
          "type": "string",
          "description": "La CLI lee la variable de entorno y la sube cifrada a la bóveda."
        },
        "vault": {
          "type": "string",
          "description": "Referencia a una credencial ya existente en la bóveda."
        },
        "oauth": {
          "type": "string",
          "description": "Credencial que se obtiene cuando el cliente AUTORIZA con su cuenta (id del proveedor OAuth). La plataforma genera el enlace."
        }
      },
      "oneOf": [
        {
          "required": [
            "from_env"
          ]
        },
        {
          "required": [
            "vault"
          ]
        },
        {
          "required": [
            "oauth"
          ]
        }
      ]
    }
  }
}
