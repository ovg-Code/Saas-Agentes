{
  "name": "saas-agentes",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma multi-tenant para desplegar agentes de IA a partir de plantillas parametrizables",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:deps": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "dev:api": "pnpm --filter @agentes/api dev",
    "agentes": "pnpm --filter @agentes/cli exec agentes",
    "eval": "pnpm --filter @agentes/cli exec agentes eval"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
